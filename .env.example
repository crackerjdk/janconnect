# GEMINI_API_KEY: Required for optional Gemini AI moderation assist calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# SESSION_SECRET: Optional server-side secret for signing session tokens (falls back to in-memory random bytes if unset).
SESSION_SECRET=""

# NATIONAL_ID_HASH_SECRET: Server-side HMAC secret for irreversible deduplication hashing of National ID numbers (never exposed client-side).
NATIONAL_ID_HASH_SECRET=""

# MODERATOR_PASSCODE: Optional server-side passcode for moderator console access.
# If unset in local preview, the first-run setup/claim flow on /admin/login allows claiming a single initial moderator account.
MODERATOR_PASSCODE=""

# SUPABASE INTEGRATION (Leave blank to run the built-in local SQLite V0.1 backend)
# Never expose SUPABASE_SERVICE_ROLE_KEY in any VITE_ environment variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# OPTIONAL MAP INTEGRATION (Manual Uttarakhand hierarchical selector is used when unset)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_MAPBOX_ACCESS_TOKEN=""

# CHILD SAFETY & CONSENT COMPLIANCE GATE
# Keep "gated" until an adult operator and qualified legal/privacy reviewer sign off on age-assurance and parental-consent requirements.
VITE_AGE_CONSENT_GATE_MODE="gated"
